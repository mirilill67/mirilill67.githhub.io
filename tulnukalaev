<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Y2K Alien Shooter</title>

<style>
  *{
    margin:0;
    padding:0;
    box-sizing:border-box;
    cursor:none;
  }

  body{
    overflow:hidden;
    background:
      radial-gradient(circle at center,#ff9de1 0%,#d96dff 40%,#5b1d87 100%);
    height:100vh;
    font-family:Verdana;
  }

  canvas{
    display:block;
  }

  /* score */
  .ui{
    position:fixed;
    top:20px;
    left:20px;
    z-index:20;
    color:white;
    font-size:28px;
    font-weight:bold;
    text-shadow:0 0 10px hotpink;
    letter-spacing:3px;
  }

  /* custom crosshair */
  .crosshair{
    position:fixed;
    width:40px;
    height:40px;
    border:3px solid white;
    border-radius:50%;
    pointer-events:none;
    transform:translate(-50%,-50%);
    z-index:999;
    box-shadow:
      0 0 10px #ff00ff,
      0 0 20px cyan;
  }

  .crosshair::before,
  .crosshair::after{
    content:"";
    position:absolute;
    background:white;
  }

  .crosshair::before{
    width:2px;
    height:50px;
    left:50%;
    top:-5px;
    transform:translateX(-50%);
  }

  .crosshair::after{
    width:50px;
    height:2px;
    left:-5px;
    top:50%;
    transform:translateY(-50%);
  }

  /* shooter gun */
  .gun{
    position:fixed;
    bottom:-20px;
    right:50px;
    width:450px;
    z-index:10;
    pointer-events:none;
    transform-origin:bottom right;
    filter:
      drop-shadow(0 0 15px #ff7eea)
      drop-shadow(0 0 35px white);
    transition:transform 0.05s linear;
  }

  .flash{
    position:fixed;
    width:120px;
    height:120px;
    border-radius:50%;
    background:radial-gradient(circle,white 0%, #ff9df9 30%, transparent 70%);
    pointer-events:none;
    opacity:0;
    z-index:15;
    mix-blend-mode:screen;
  }

  .stars{
    position:absolute;
    width:100%;
    height:100%;
    background-image:
      radial-gradient(white 1px, transparent 1px),
      radial-gradient(#ffd2ff 1px, transparent 1px);
    background-size:120px 120px, 200px 200px;
    opacity:0.5;
    animation:moveStars 10s linear infinite;
  }

  @keyframes moveStars{
    from{
      transform:translateY(0);
    }
    to{
      transform:translateY(-120px);
    }
  }

  .title{
    position:fixed;
    top:20px;
    right:30px;
    font-size:52px;
    font-weight:bold;
    color:#ffd7ff;
    font-style:italic;
    text-shadow:
      0 0 10px #ff7de9,
      0 0 30px white;
    z-index:100;
    line-height:0.8;
    text-align:right;
  }

  .hit{
    animation:explode 0.3s forwards;
  }

  @keyframes explode{
    to{
      transform:scale(2);
      opacity:0;
    }
  }
</style>
</head>

<body>

<div class="stars"></div>

<div class="ui">
  SCORE: <span id="score">0</span>
</div>

<div class="title">
  INTERNET<br>ANGEL
</div>

<div class="crosshair" id="crosshair"></div>
<div class="flash" id="flash"></div>

<!-- YOUR IMAGE -->
<img
  class="gun"
  id="gun"
  src="attachment:image.png"
/>

<canvas id="game"></canvas>

<script>
const canvas = document.getElementById("game");
const ctx = canvas.getContext("2d");

canvas.width = innerWidth;
canvas.height = innerHeight;

const scoreEl = document.getElementById("score");
const crosshair = document.getElementById("crosshair");
const flash = document.getElementById("flash");
const gun = document.getElementById("gun");

let score = 0;

const ufos = [];

function resize(){
  canvas.width = innerWidth;
  canvas.height = innerHeight;
}

window.addEventListener("resize", resize);

class UFO{
  constructor(){
    this.x = Math.random() * canvas.width;
    this.y = Math.random() * canvas.height * 0.6;

    this.size = 40 + Math.random() * 50;

    this.speed =
      1 + Math.random() * 3;

    this.direction =
      Math.random() > 0.5 ? 1 : -1;

    this.alive = true;
  }

  draw(){

    ctx.save();

    ctx.translate(this.x,this.y);

    // glow
    ctx.shadowColor = "#00ffff";
    ctx.shadowBlur = 20;

    // dome
    ctx.fillStyle = "#c7f6ff";
    ctx.beginPath();
    ctx.ellipse(
      0,
      -10,
      this.size * 0.25,
      this.size * 0.18,
      0,
      0,
      Math.PI * 2
    );
    ctx.fill();

    // base
    ctx.fillStyle = "#b8b8b8";

    ctx.beginPath();
    ctx.ellipse(
      0,
      0,
      this.size * 0.5,
      this.size * 0.18,
      0,
      0,
      Math.PI * 2
    );

    ctx.fill();

    // lights
    for(let i=-2;i<=2;i++){
      ctx.fillStyle = i % 2 === 0 ? "#ff5cff" : "#7dffff";

      ctx.beginPath();
      ctx.arc(
        i * 15,
        5,
        4,
        0,
        Math.PI * 2
      );
      ctx.fill();
    }

    ctx.restore();
  }

  update(){
    this.x += this.speed * this.direction;

    if(this.direction === 1 && this.x > canvas.width + 100){
      this.x = -100;
    }

    if(this.direction === -1 && this.x < -100){
      this.x = canvas.width + 100;
    }

    this.draw();
  }
}

for(let i=0;i<8;i++){
  ufos.push(new UFO());
}

function animate(){

  ctx.clearRect(0,0,canvas.width,canvas.height);

  ufos.forEach(ufo=>{
    if(ufo.alive){
      ufo.update();
    }
  });

  requestAnimationFrame(animate);
}

animate();

document.addEventListener("mousemove",(e)=>{

  crosshair.style.left = e.clientX + "px";
  crosshair.style.top = e.clientY + "px";

  // slight gun movement
  const rotate =
    (e.clientX / window.innerWidth - 0.5) * 10;

  gun.style.transform =
    `rotate(${rotate}deg)`;
});

document.addEventListener("click",(e)=>{

  // muzzle flash
  flash.style.left =
    (window.innerWidth - 170) + "px";

  flash.style.top =
    (window.innerHeight - 220) + "px";

  flash.style.opacity = 1;

  setTimeout(()=>{
    flash.style.opacity = 0;
  },80);

  // gun recoil
  gun.style.transform += " translateY(20px)";

  setTimeout(()=>{
    gun.style.transform =
      gun.style.transform.replace(" translateY(20px)","");
  },50);

  // hit detection
  ufos.forEach(ufo=>{

    const dx = e.clientX - ufo.x;
    const dy = e.clientY - ufo.y;

    const dist = Math.sqrt(dx*dx + dy*dy);

    if(dist < ufo.size * 0.5 && ufo.alive){

      ufo.alive = false;

      score += 100;
      scoreEl.textContent = score;

      // respawn
      setTimeout(()=>{
        Object.assign(ufo,new UFO());
      },800);
    }
  });
});
</script>

</body>
</html>
