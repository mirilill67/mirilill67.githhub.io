draw() {

  ctx.save();

  const floatY =
    Math.sin(Date.now() * 0.002 + this.floatOffset) * 10;

  ctx.translate(this.x, this.y + floatY);

  /* =========================
     MAIN GLOW
  ========================= */

  ctx.shadowColor = "#7dffff";
  ctx.shadowBlur = 35;

  /* =========================
     TRACTOR BEAM
  ========================= */

  const beam = ctx.createLinearGradient(
    0,
    20,
    0,
    180
  );

  beam.addColorStop(0, "rgba(125,255,255,0.25)");
  beam.addColorStop(1, "rgba(125,255,255,0)");

  ctx.fillStyle = beam;

  ctx.beginPath();

  ctx.moveTo(-25, 15);
  ctx.lineTo(25, 15);
  ctx.lineTo(70, 180);
  ctx.lineTo(-70, 180);

  ctx.closePath();
  ctx.fill();

  /* =========================
     BOTTOM SHADOW DISC
  ========================= */

  ctx.beginPath();

  ctx.fillStyle = "rgba(0,0,0,0.25)";

  ctx.ellipse(
    0,
    18,
    this.size * 0.45,
    this.size * 0.08,
    0,
    0,
    Math.PI * 2
  );

  ctx.fill();

  /* =========================
     TOP GLASS DOME
  ========================= */

  const domeGrad = ctx.createLinearGradient(
    0,
    -40,
    0,
    10
  );

  domeGrad.addColorStop(0, "#ffffff");
  domeGrad.addColorStop(0.3, "#dffcff");
  domeGrad.addColorStop(1, "#7df9ff");

  ctx.fillStyle = domeGrad;

  ctx.beginPath();

  ctx.ellipse(
    0,
    -18,
    this.size * 0.22,
    this.size * 0.18,
    0,
    Math.PI,
    Math.PI * 2
  );

  ctx.fill();

  /* dome reflection */

  ctx.fillStyle = "rgba(255,255,255,0.7)";

  ctx.beginPath();

  ctx.ellipse(
    -10,
    -25,
    this.size * 0.05,
    this.size * 0.02,
    -0.5,
    0,
    Math.PI * 2
  );

  ctx.fill();

  /* =========================
     METALLIC BODY
  ========================= */

  const metal = ctx.createLinearGradient(
    -this.size,
    0,
    this.size,
    0
  );

  metal.addColorStop(0, "#5ef2ff");
  metal.addColorStop(0.2, "#ffffff");
  metal.addColorStop(0.45, "#ff8cf8");
  metal.addColorStop(0.7, "#d9d9d9");
  metal.addColorStop(1, "#6ef3ff");

  ctx.fillStyle = metal;

  ctx.beginPath();

  ctx.ellipse(
    0,
    0,
    this.size * 0.6,
    this.size * 0.22,
    0,
    0,
    Math.PI * 2
  );

  ctx.fill();

  /* =========================
     LOWER RIM
  ========================= */

  ctx.strokeStyle = "#ffffffcc";
  ctx.lineWidth = 3;

  ctx.beginPath();

  ctx.ellipse(
    0,
    4,
    this.size * 0.58,
    this.size * 0.18,
    0,
    0,
    Math.PI * 2
  );

  ctx.stroke();

  /* =========================
     LIGHT PANELS
  ========================= */

  for (let i = -3; i <= 3; i++) {

    const lightX = i * (this.size * 0.14);

    ctx.beginPath();

    ctx.fillStyle =
      i % 2 === 0
      ? "#ff5cf4"
      : "#7dffff";

    ctx.shadowColor = ctx.fillStyle;
    ctx.shadowBlur = 15;

    ctx.arc(
      lightX,
      8,
      this.size * 0.035,
      0,
      Math.PI * 2
    );

    ctx.fill();
  }

  /* =========================
     SIDE WINGS
  ========================= */

  ctx.fillStyle = "#d9d9d9";

  // left wing
  ctx.beginPath();

  ctx.moveTo(-this.size * 0.45, 0);
  ctx.lineTo(-this.size * 0.75, 10);
  ctx.lineTo(-this.size * 0.55, -5);

  ctx.closePath();
  ctx.fill();

  // right wing
  ctx.beginPath();

  ctx.moveTo(this.size * 0.45, 0);
  ctx.lineTo(this.size * 0.75, 10);
  ctx.lineTo(this.size * 0.55, -5);

  ctx.closePath();
  ctx.fill();

  /* =========================
     ANTENNA
  ========================= */

  ctx.strokeStyle = "#ffffff";
  ctx.lineWidth = 2;

  ctx.beginPath();

  ctx.moveTo(0, -40);
  ctx.lineTo(0, -55);

  ctx.stroke();

  ctx.beginPath();

  ctx.fillStyle = "#ff5cf4";

  ctx.arc(
    0,
    -58,
    4,
    0,
    Math.PI * 2
  );

  ctx.fill();

  /* =========================
     SPARKLE
  ========================= */

  ctx.strokeStyle = "#ffffff";
  ctx.lineWidth = 2;

  ctx.beginPath();

  ctx.moveTo(-this.size * 0.9, -25);
  ctx.lineTo(-this.size * 0.75, -25);

  ctx.moveTo(-this.size * 0.825, -35);
  ctx.lineTo(-this.size * 0.825, -15);

  ctx.stroke();

  ctx.restore();
}
